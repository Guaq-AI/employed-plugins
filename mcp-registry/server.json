{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "me.guaqai.jobs/employed",
  "title": "Employed by Guaq AI",
  "description": "Live jobs from ~5,000 employer ATS boards, hiring profiles, your job profile and tracker.",
  "version": "1.2.2",
  "websiteUrl": "https://jobs.guaqai.me",
  "repository": {
    "url": "https://github.com/Guaq-AI/employed-plugins",
    "source": "github"
  },
  "icons": [
    {
      "src": "https://jobs.guaqai.me/assets/brand/logo-square-512.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://jobs.guaqai.me/mcp"
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "employed-mcp",
      "version": "1.2.1",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "GUAQ_API_KEY",
          "isRequired": true,
          "isSecret": true,
          "format": "string",
          "description": "Employed API key from https://jobs.guaqai.me/profile (the remote server signs in with OAuth instead)."
        }
      ]
    }
  ]
}
