{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "me.guaqai.jobs/employed",
  "title": "Employed by Guaq AI",
  "description": "Live job search across ~5,000 verified employer ATS boards, with hiring profiles and signals.",
  "version": "1.0.4",
  "websiteUrl": "https://jobs.guaqai.me",
  "repository": {
    "url": "https://github.com/buddywhitman/resume-cv",
    "source": "github",
    "subfolder": "scraper/npm/employed-mcp"
  },
  "icons": [
    {
      "src": "https://jobs.guaqai.me/assets/brand/icon-512.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "identifier": "employed-mcp",
      "version": "1.0.4",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "GUAQ_API_KEY",
          "description": "API key from https://jobs.guaqai.me/profile",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://jobs.guaqai.me/mcp"
    }
  ]
}
